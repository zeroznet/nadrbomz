# -----------------------------------------------------------------------------
# Shared aliases, shell-safe functions, SSH agent setup and host-specific bits
# for Bash and Zsh. Source from both ~/.zshrc and ~/.bashrc.
# -----------------------------------------------------------------------------

# Guard: interactive shells only.
case $- in
  *i*) ;;
  *) return 0 2>/dev/null || exit 0 ;;
esac

# -----------------------------------------------------------------------------
# Truecolor advert.
# Set COLORTERM=truecolor only when TERM advertises a 256-color capable
# terminfo. Skips bare xterm (PuTTY default), linux console, dumb, etc,
# so apps don't emit 24-bit SGR into terminals that can't render them.
# Respects COLORTERM that the terminal already exported (iTerm2, Alacritty).
# -----------------------------------------------------------------------------

case "$TERM" in
  *-256color|tmux*|alacritty|xterm-kitty)
    export COLORTERM="${COLORTERM:-truecolor}"
    ;;
esac

# -----------------------------------------------------------------------------
# TERMCAP.
# screen exports an 8-color TERMCAP that FreeBSD ncurses honors over terminfo,
# capping TUIs (lnav) at 8 colors. Unset it so the 256-color terminfo wins.
# $STY is set only inside screen, so this is a no-op everywhere else.
# -----------------------------------------------------------------------------

[ -n "$STY" ] && unset TERMCAP

# -----------------------------------------------------------------------------
# Host detection.
# -----------------------------------------------------------------------------

__rb_host="${HOST:-${HOSTNAME:-$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo unknown)}}"

# -----------------------------------------------------------------------------
# SSH agent.
# Local WSL session: shared fixed-socket agent, passphrase asked once per boot.
# zsh already exports the socket from ~/.zshenv; bash does not read that file,
# so it is exported here too. Anywhere else: keychain when
# ~/.ssh/keychain_enabled exists.
# -----------------------------------------------------------------------------

if [ -n "${WSL_DISTRO_NAME:-}" ] && [ -z "${SSH_CONNECTION:-}" ]; then
  export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ssh-agent.sock"
  [ -x "$HOME/.local/bin/ssh-key-ensure" ] && "$HOME/.local/bin/ssh-key-ensure"
elif [ -f "$HOME/.ssh/keychain_enabled" ] && command -v keychain >/dev/null 2>&1; then
  __rb_keychain_args="$(cat "$HOME/.ssh/keychain_enabled")"
  keychain -q $__rb_keychain_args
  [ -f "$HOME/.keychain/${__rb_host}-sh" ] && . "$HOME/.keychain/${__rb_host}-sh"
  unset __rb_keychain_args
fi

# -----------------------------------------------------------------------------
# Core aliases.
# -----------------------------------------------------------------------------

alias e='nvim'
alias glow='glow -p'
alias sdr='screen -dr'
alias lh='ssh localhost.sk -p 443'
alias vanguard='AUTOSSH_GATETIME=0 autossh -M 0 -t vanguard "screen -DRS main"'
alias sentinel='AUTOSSH_GATETIME=0 autossh -M 0 -t sentinel "screen -DRS main"'
alias s='sudo su -'
alias si='sudo -i'
alias su='su -'

# -----------------------------------------------------------------------------
# Log viewer.
# Linux: follow the last hour of the journal as JSON through lnav.
# FreeBSD: follow the last 1000 lines of /var/log/all; tail -F survives newsyslog
# rotations. sudo -v asks for the password up front, since a prompt from inside
# the substitution fights lnav for the tty. tail is fed through process
# substitution, not a pipe: BSD tail only notices lnav is gone on its next
# write, and the shell would wait for it after q.
# -----------------------------------------------------------------------------

case "$(uname -s)" in
  Linux)   alias slog='sudo journalctl --since "1 hour ago" -f -o json | lnav' ;;
  FreeBSD) alias slog='sudo -v && lnav <(sudo tail -F -n 1000 /var/log/all)' ;;
esac

# -----------------------------------------------------------------------------
# ls aliases.
# GNU ls uses --color=auto.
# BSD ls uses -G.
# -----------------------------------------------------------------------------

if ls --color=auto >/dev/null 2>&1; then
  alias ls='ls --color=auto'
elif ls -G >/dev/null 2>&1; then
  alias ls='ls -G'
fi

alias l='ls -lah'
alias la='ls -lah'
alias ll='ls -lh'
alias lsa='ls -lah'

# -----------------------------------------------------------------------------
# Docker wrapper.
# Uses docker directly if available for current user.
# Falls back to sudo docker when needed.
# -----------------------------------------------------------------------------

dk() {
  if ! command -v docker >/dev/null 2>&1; then
    printf 'docker not found\n' >&2
    return 127
  fi

  if docker info >/dev/null 2>&1; then
    docker "$@"
    return
  fi

  if command -v sudo >/dev/null 2>&1; then
    sudo docker "$@"
    return
  fi

  docker "$@"
}

alias dps='dk ps'
alias dpa='dk ps -a'
alias di='dk images'
alias dl='dk logs'

# -----------------------------------------------------------------------------
# Host-specific bits.
# -----------------------------------------------------------------------------

if [ "$__rb_host" = "USDSCWN34032527" ]; then
  export USE_GKE_GCLOUD_AUTH_PLUGIN=True
  export AZURE_CLI_DISABLE_CONNECTION_VERIFICATION=anycontent

  alias wcd='cd "/c/Documents and Settings/rbopko"'

  if command -v kubectl >/dev/null 2>&1; then
    if [ -n "${ZSH_VERSION:-}" ]; then
      source <(kubectl completion zsh)
    else
      source <(kubectl completion bash)
    fi
    alias k='kubectl'
    alias kn='kubectl ns'
    alias kubens='kubectl ns'
    alias kc='kubectl ctx'
    alias kubectx='kubectl ctx'
  fi
else
  unset MAILCHECK
fi

unset __rb_host
